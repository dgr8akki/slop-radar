{
  "name": "slop-radar",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome extension that tags posts in your LinkedIn feed by how much they read like generic AI writing.",
  "type": "module",
  "license": "MIT",
  "author": "Aakash Pahuja",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgr8akki/slop-radar.git"
  },
  "bugs": "https://github.com/dgr8akki/slop-radar/issues",
  "homepage": "https://github.com/dgr8akki/slop-radar#readme",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "eval": "node --env-file-if-exists=.env test/live/rating.js",
    "icons": "node scripts/render-icons.js",
    "package": "node scripts/package.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9"
  }
}
